/* ============================================================
   LÓGICA DE LA INVITACIÓN
   ============================================================ */

const $  = sel => document.querySelector(sel);
const $$ = sel => Array.from(document.querySelectorAll(sel));

/* Si el invitado pidió menos movimiento, se apagan los efectos */
const SIN_MOVIMIENTO = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

document.addEventListener("DOMContentLoaded", () => {
  pintarTextos();
  prepararPuertas();
  iniciarCuentaRegresiva();
  construirGaleria();
  construirItinerario();
  construirGuirnalda();
  construirRegalos();
  cargarInvitacion();
  prepararFormulario();
  pintarMuro();
  prepararMusica();
  prepararAparicion();
  prepararScroll();
  prepararParallax();
  sembrarPetalos();
});

/* ------------------------------------------------------------
   Petalos que caen: pocos, lentos, cada uno con su deriva
   ------------------------------------------------------------ */
function sembrarPetalos() {
  if (SIN_MOVIMIENTO) return;
  $$(".petalos").forEach(zona => {
    const cuantos = parseInt(zona.dataset.petalos || "5", 10);
    for (let i = 0; i < cuantos; i++) {
      const p = document.createElement("i");
      p.className = "petalo";
      p.style.left = `${(4 + Math.random() * 92).toFixed(1)}%`;
      p.style.width = `${(10 + Math.random() * 9).toFixed(0)}px`;
      p.style.setProperty("--deriva", `${(Math.random() * 120 - 60).toFixed(0)}px`);
      p.style.setProperty("--vuelta", `${(180 + Math.random() * 360).toFixed(0)}deg`);
      p.style.animationDuration = `${(9 + Math.random() * 8).toFixed(1)}s`;
      p.style.animationDelay = `${(Math.random() * 12).toFixed(1)}s`;
      if (Math.random() < .5) p.style.filter = `hue-rotate(${(Math.random() * 14 - 7).toFixed(0)}deg)`;
      zona.appendChild(p);
    }
  });
}

/* Al terminar de cargar se apaga el preloader y la camara echa a andar */
window.addEventListener("load", () => {
  setTimeout(() => {
    $("#preloader").classList.add("listo");
    iniciarVideoIntro();
  }, 500);
});

/* ------------------------------------------------------------
   La intro en video

   Un solo MP4 trae el paseo, la llegada y la apertura. Aqui solo se
   dirige: al cargar arranca; en PAUSA_VIDEO (la puerta encuadrada, un
   instante antes de abrirse) se pausa y espera el toque; al entrar
   sigue, y cuando el destello final ya ciega entra el velo blanco.

   La vigilancia va fotograma a fotograma (requestVideoFrameCallback)
   porque timeupdate avisa solo 4 veces por segundo: pausaria tarde.
   ------------------------------------------------------------ */
// 4.5: el ultimo instante con la puerta cerrada del todo (en 4.8 ya
// asoma la rendija de luz arriba). Asi el toque parece abrirla.
const PAUSA_VIDEO = 4.5;
// Este video NO funde a blanco -acaba en la terraza con vista al mar-,
// asi que el velo entra antes y mas despacio para hacer el fundido el.
const VELO_VIDEO  = 8.9;
// El velo tarda 1s en llegar al blanco pleno (la transicion de .velo).
// La musica entra ahi: con la pantalla ya toda blanca, no con el toque.
const BLANCO_PLENO = 1000;

function vigilarVideo(video, objetivo, accion) {
  const paso = () => {
    if (video.currentTime >= objetivo) { accion(); return; }
    if (video.requestVideoFrameCallback) video.requestVideoFrameCallback(paso);
    else requestAnimationFrame(paso);
  };
  paso();
}

function iniciarVideoIntro() {
  const puertas = $("#puertas");
  const video   = $("#videoIntro");
  if (!puertas || !video) return;
  video.muted = true;               // requisito de autoplay, ademas del atributo

  const llegar = () => {
    // Si el invitado ya toco (abriendo), no hay nada que pausar: sin este
    // guarda, el vigilante del paseo congelaba el video justo despues del
    // toque anticipado, y con el video pausado el vigilante del velo
    // -que va por fotogramas- no volvia a disparar jamas.
    if (puertas.classList.contains("llegada") ||
        puertas.classList.contains("abriendo")) return;
    video.pause();
    puertas.classList.add("llegada");
  };

  const alFrenteDeLaPuerta = () => {
    const t = () => { video.currentTime = PAUSA_VIDEO; puertas.classList.add("llegada"); };
    if (video.readyState >= 1) t();
    else video.addEventListener("loadedmetadata", t, { once: true });
  };

  if (SIN_MOVIMIENTO) { alFrenteDeLaPuerta(); return; }

  // si el autoplay fallara (raro yendo silenciado), se salta el paseo
  video.play()
    .then(() => vigilarVideo(video, PAUSA_VIDEO, llegar))
    .catch(alFrenteDeLaPuerta);
}

/* ------------------------------------------------------------
   Textos desde datos.js
   ------------------------------------------------------------ */
function pintarTextos() {
  const cuando = `${DATOS.fechaTexto} · ${DATOS.horaTexto}`;
  const imagenes = DATOS.imagenes || {};
  const rutaCss = ruta => ruta ? `url("${ruta.replace(/["\\]/g, "\\$&")}")` : "none";

  document.documentElement.style.setProperty("--imagen-portada", rutaCss(imagenes.portada));
  document.documentElement.style.setProperty("--imagen-galeria-movil", rutaCss(imagenes.galeriaMovil));
  document.documentElement.style.setProperty("--imagen-galeria-web", rutaCss(imagenes.galeriaEscritorio));

  $("#heroNombre").textContent = DATOS.nombreCompleto;
  $("#pieNombre").textContent  = DATOS.nombreCompleto;
  document.title = `Mis XV Años · ${DATOS.nombreCompleto}`;

  // fecha y hora en dos lineas siempre: nada de puntos huerfanos
  $("#heroFecha").innerHTML =
    `${DATOS.fechaTexto}<br><b style="font-weight:600;letter-spacing:.08em">${DATOS.horaTexto}</b>`;
  $("#pieDatos").textContent  = `${DATOS.fechaTexto} · ${DATOS.lugar.nombre}`;
  $("#fraseTexto").textContent = DATOS.fraseIntro;

  $("#lugarNombre").textContent    = DATOS.lugar.nombre;
  $("#lugarDireccion").textContent = DATOS.lugar.direccion;
  $("#lugarHora").textContent      = cuando;
  $("#btnMaps").href = DATOS.lugar.googleMaps;
  $("#btnWaze").href = DATOS.lugar.waze;

  $("#vestimentaTitulo").textContent     = DATOS.vestimenta.titulo;
  $("#vestimentaDamas").textContent      = DATOS.vestimenta.damas;
  $("#vestimentaCaballeros").textContent = DATOS.vestimenta.caballeros;

  if (DATOS.vestimenta.nota) {
    $("#vestimentaNota").textContent = DATOS.vestimenta.nota;
    $("#vestimentaNota").hidden = false;
  }

  const R = DATOS.rsvp;
  $("#tituloConfirmacion").textContent = R.titulo;
  $("#textoConfirmacion").textContent = R.subtitulo;
  $("#etiquetaAsistencia").textContent = R.etiquetaAsistencia;
  $("label[for='campoNombre']").textContent = R.etiquetaNombre;
  $("#textoAsisteSi").textContent = R.opcionSi;
  $("#textoAsisteNo").textContent = R.opcionNo;
  $("label[for='campoCancion']").textContent = R.etiquetaCancion;
  $("label[for='campoMensaje']").textContent = R.etiquetaMensaje;
  $("#btnEnviar .btn-texto").textContent = R.boton;
  $("#errorNombre").textContent = R.errorNombre;
  $("#errorAsiste").textContent = R.errorAsiste;

  $("#paseLugar").textContent   = `${DATOS.lugar.nombre} · ${DATOS.fechaTexto}`;
  $("#limiteTexto").textContent = `Confirma antes del ${DATOS.rsvp.fechaLimite}.`;
}

/* ------------------------------------------------------------
   Las puertas: el momento de entrar
   ------------------------------------------------------------ */
function prepararPuertas() {
  const puertas = $("#puertas");
  const centro  = $("#puertasCentro");
  const video   = $("#videoIntro");
  if (!puertas || !centro || !video) return;

  const cambiarDeMundo = () => {
    document.body.classList.remove("cerrado");
    window.scrollTo(0, 0);
    puertas.remove();
    const velo = $("#velo");
    velo.classList.add("saliendo");
    setTimeout(() => velo.remove(), 1400);
  };

  // el fundido a blanco: al completarse entra la musica y ya carga la portada
  const fundirABlanco = () => {
    const velo = $("#velo");
    if (velo.classList.contains("visible")) return;
    velo.classList.add("visible");
    setTimeout(() => Musica.sonar(), BLANCO_PLENO);
  };

  const entrar = () => {
    if (puertas.classList.contains("abriendo")) return;

    // toco antes de llegar: se salta el paseo y se abre directamente
    if (!puertas.classList.contains("llegada")) video.currentTime = PAUSA_VIDEO;

    puertas.classList.add("abriendo");
    Musica.desbloquear();            // iPhone: el audio debe nacer del toque

    if (SIN_MOVIMIENTO) {
      fundirABlanco();
      setTimeout(cambiarDeMundo, 650);
      return;
    }

    video.play().catch(() => { fundirABlanco(); setTimeout(cambiarDeMundo, 650); });
    vigilarVideo(video, VELO_VIDEO, fundirABlanco);
    video.addEventListener("ended", () => setTimeout(cambiarDeMundo, 150), { once: true });
  };

  if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    $(".puertas-accion").textContent = "Haz clic para entrar";
  }

  centro.addEventListener("click", entrar);
  centro.addEventListener("keydown", e => {
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); entrar(); }
  });
}

/* ------------------------------------------------------------
   Cuenta regresiva
   ------------------------------------------------------------ */
function iniciarCuentaRegresiva() {
  const destino = new Date(DATOS.fechaISO).getTime();

  if (isNaN(destino)) {
    $("#relojTexto").textContent = "Revisa el campo fechaISO en js/datos.js";
    return;
  }

  const actualizar = () => {
    const faltan = destino - Date.now();

    if (faltan <= 0) {
      $("#reloj").style.display = "none";
      $("#relojTexto").textContent = "¡Hoy es el día!";
      clearInterval(reloj);
      return;
    }

    const seg = Math.floor(faltan / 1000);
    $("#dias").textContent     = Math.floor(seg / 86400);
    $("#horas").textContent    = String(Math.floor(seg % 86400 / 3600)).padStart(2, "0");
    $("#minutos").textContent  = String(Math.floor(seg % 3600 / 60)).padStart(2, "0");
    $("#segundos").textContent = String(seg % 60).padStart(2, "0");
  };

  actualizar();
  const reloj = setInterval(actualizar, 1000);
}

/* ------------------------------------------------------------
   Galería: fundido con un acercamiento suave
   ------------------------------------------------------------ */
function construirGaleria() {
  const pista  = $("#galeriaPista");
  const puntos = $("#galeriaPuntos");
  const total  = DATOS.fotos.length;
  let actual = 0;
  let auto;

  pista.replaceChildren();
  puntos.replaceChildren();

  if (total === 0) { $("#seccionGaleria").remove(); return; }

  DATOS.fotos.forEach((foto, i) => {
    const lamina = document.createElement("div");
    lamina.className = "galeria-lamina" + (i === 0 ? " activa" : "");
    lamina.innerHTML =
      `<img src="${foto.archivo}" alt="Emma Victoria, foto ${i + 1} de ${total}"
            ${i === 0 ? "" : 'loading="lazy"'}>` +
      (foto.texto ? `<div class="galeria-pie">${foto.texto}</div>` : "");
    pista.appendChild(lamina);

    const punto = document.createElement("button");
    punto.className = "punto" + (i === 0 ? " activo" : "");
    punto.setAttribute("aria-label", `Ir a la foto ${i + 1}`);
    punto.addEventListener("click", () => { ir(i); reiniciarAuto(); });
    puntos.appendChild(punto);
  });

  const laminas = $$("#galeriaPista .galeria-lamina");

  function ir(indice) {
    actual = (indice + total) % total;
    laminas.forEach((l, i) => l.classList.toggle("activa", i === actual));
    $$("#galeriaPuntos .punto").forEach((p, i) => p.classList.toggle("activo", i === actual));
  }


  // Deslizar con el dedo
  let inicioX = 0;
  pista.addEventListener("touchstart", e => inicioX = e.touches[0].clientX, { passive: true });
  pista.addEventListener("touchend", e => {
    const recorrido = e.changedTouches[0].clientX - inicioX;
    if (Math.abs(recorrido) > 45) { ir(actual + (recorrido < 0 ? 1 : -1)); reiniciarAuto(); }
  }, { passive: true });

  function reiniciarAuto() {
    clearInterval(auto);
    if (!SIN_MOVIMIENTO) auto = setInterval(() => ir(actual + 1), 5500);
  }
  reiniciarAuto();
}

/* ------------------------------------------------------------
   Itinerario
   ------------------------------------------------------------ */
function construirItinerario() {
  const lista = $("#lineaTiempo");
  lista.replaceChildren();

  DATOS.itinerario.forEach(paso => {
    const hito = document.createElement("li");
    hito.className = "hito" + (/entrada/i.test(paso.titulo) ? " destacado" : "");
    hito.innerHTML = `
      <div class="hito-tarjeta">
        <p class="hito-hora">${paso.hora}</p>
        <p class="hito-titulo">${paso.titulo}</p>
        ${paso.detalle ? `<p class="hito-detalle">${paso.detalle}</p>` : ""}
      </div>`;
    lista.appendChild(hito);
  });

  // Durante la fiesta, marca en qué momento vamos
  const inicio = new Date(DATOS.fechaISO).getTime();
  const ahora  = Date.now();
  if (ahora >= inicio && ahora <= inicio + 8 * 3600 * 1000) {
    const transcurrido = (ahora - inicio) / 3600000;
    const indice = DATOS.itinerario.findIndex((_, i) => i / 2 > transcurrido);
    if (indice > -1) lista.children[indice].classList.add("proximo");
  } else {
    lista.children[0].classList.add("proximo");
  }
}

/* ------------------------------------------------------------
   Guirnalda de luces del toldo
   ------------------------------------------------------------ */
function construirGuirnalda() {
  const g = $("#guirnalda");
  g.replaceChildren();
  for (let i = 0; i < 14; i++) {
    const luz = document.createElement("i");
    luz.style.animationDelay = `${(Math.random() * 2.6).toFixed(2)}s`;
    g.appendChild(luz);
  }
}

/* ------------------------------------------------------------
   Puestos reservados

   El numero viaja en el enlace de cada invitado: ?p=4 (tambien vale
   ?puestos=4). Sin parametro -o con un numero raro- la seccion ni
   aparece, y el enlace limpio sigue funcionando como siempre.
   ------------------------------------------------------------ */
const ENLACE = { puestos: null, familia: null, saludo: null, trato: null };

/* Lee el enlace y, si trae codigo de familia (?f=garcia), busca en
   Supabase su saludo y sus puestos. Un ?p=N escrito a mano manda
   sobre lo que diga la tabla; sin red, la invitacion sigue igual,
   solo que sin saludo. */
async function cargarInvitacion() {
  const enlace = new URLSearchParams(location.search);
  ENLACE.familia = (enlace.get("f") ?? enlace.get("familia") ?? "").trim() || null;
  const n = parseInt(enlace.get("p") ?? enlace.get("puestos"), 10);
  if (Number.isInteger(n) && n >= 1 && n <= 99) ENLACE.puestos = n;

  if (ENLACE.familia) {
    try {
      const S = DATOS.supabase;
      const r = await fetch(`${S.url}/rest/v1/invitaciones?codigo=eq.${encodeURIComponent(ENLACE.familia)}&select=*`,
        { headers: { apikey: S.clave, Authorization: `Bearer ${S.clave}` } });
      const [inv] = r.ok ? await r.json() : [];
      if (inv) {
        ENLACE.saludo = inv.saludo;
        ENLACE.trato = inv.trato || null;
        if (!ENLACE.puestos) ENLACE.puestos = inv.puestos;
      }
    } catch (e) { /* sin red: sin saludo, y ya */ }
  }

  pintarSaludo();
  pintarPuestos();
  montarAcompanantes();
}

/* Saludo personalizado para la familia invitada, antes de entrar. */
function pintarSaludo() {
  const sitio = $("#puertasSaludo");
  if (!ENLACE.saludo || !sitio) return;
  sitio.innerHTML = `${escapar(ENLACE.trato || "Bienvenidos")} a la velada<b>${escapar(ENLACE.saludo)}</b>`;
  sitio.hidden = false;
}

function pintarPuestos() {
  const n = ENLACE.puestos;
  if (!n) return;
  $("#puestosTexto").innerHTML = n === 1
    ? "Hemos reservado <b>1</b> lugar para ti."
    : `Hemos reservado <b>${n}</b> lugares para ti.`;
  $("#seccionPuestos").hidden = false;
}

/* Un campo por acompanante bajo el nombre. Sin exigirlos: la etiqueta
   pide el nombre y con eso basta; si alguno queda vacio, pasa. */
function montarAcompanantes() {
  if (!(ENLACE.puestos > 1) || Almacen.mia()) return;
  let tras = $("#campoNombre").closest(".campo");
  for (let i = 1; i < ENLACE.puestos; i++) {
    const campo = document.createElement("div");
    campo.className = "campo campo-acompanante";
    campo.innerHTML = `
      <input type="text" id="campoAcomp${i}" autocomplete="off" placeholder=" ">
      <label for="campoAcomp${i}">Nombre del acompañante ${i}</label>`;
    tras.insertAdjacentElement("afterend", campo);
    tras = campo;
  }
}

/* ------------------------------------------------------------
   Regalos
   ------------------------------------------------------------ */
function construirRegalos() {
  const R = DATOS.regalos;
  $("#regalosMensaje").textContent = R.mensaje;

  // el rotulo va aunque no haya datos bancarios a la vista
  if (R.lluviaDeSobres) {
    const rotulo = document.createElement("p");
    rotulo.className = "regalos-lluvia";
    rotulo.textContent = "Lluvia de sobres";
    $("#regalosBanco").appendChild(rotulo);
  }

  if (R.cuenta) {
    const caja = document.createElement("div");
    caja.className = "datos-banco";
    caja.innerHTML = `
      <dl>
        <div><dt>Banco</dt><dd>${R.banco}</dd></div>
        <div><dt>Cuenta</dt><dd>${R.cuenta}</dd></div>
        <div><dt>A nombre de</dt><dd>${R.titular}</dd></div>
      </dl>
      <div class="fila-botones">
        <button type="button" class="boton boton-azul" id="btnCopiar">
          <svg><use href="#ico-copiar"/></svg> Copiar número
        </button>
      </div>`;
    $("#regalosBanco").appendChild(caja);

    $("#btnCopiar").addEventListener("click", () => {
      navigator.clipboard.writeText(R.cuenta)
        .then(() => mostrarAviso("Número de cuenta copiado"))
        .catch(() => mostrarAviso("No se pudo copiar, anótalo a mano"));
    });
  }

  R.tiendas.forEach(t => {
    const enlace = document.createElement("a");
    enlace.className = "boton boton-linea";
    enlace.href = t.url;
    enlace.target = "_blank";
    enlace.rel = "noopener";
    enlace.textContent = t.nombre;
    $("#regalosTiendas").appendChild(enlace);
  });
}

/* ------------------------------------------------------------
   Formulario
   ------------------------------------------------------------ */
function prepararFormulario() {
  const form  = $("#formRsvp");
  const boton = $("#btnEnviar");

  $("#errorNombre").classList.remove("visible");
  $("#errorAsiste").classList.remove("visible");

  // Si ya confirmó desde este navegador, directo al pase: evita
  // confirmaciones dobles de la misma persona sin querer.
  const mia = Almacen.mia();
  if (mia) {
    form.style.display = "none";
    mostrarPase(mia, true);
    return;
  }

  form.addEventListener("submit", async e => {
    e.preventDefault();

    const nombre = $("#campoNombre").value.trim();
    const asiste = form.querySelector('input[name="asiste"]:checked');
    let valido = true;

    $("#errorNombre").classList.toggle("visible", nombre.length < 3);
    if (nombre.length < 3) valido = false;

    $("#errorAsiste").classList.toggle("visible", !asiste);
    if (!asiste) valido = false;

    if (!valido || boton.classList.contains("enviando")) return;

    boton.classList.add("enviando");
    boton.querySelector(".btn-texto").textContent = "Enviando...";

    let registro;
    try {
      registro = await Almacen.guardar({
        nombre,
        acompanantes: $$(".campo-acompanante input").map(c => c.value),
        puestos: ENLACE.puestos,
        familia: ENLACE.familia,
        asiste: asiste.value,
        cancion: $("#campoCancion").value,
        mensaje: $("#campoMensaje").value
      });
    } catch (err) {
      boton.classList.remove("enviando");
      boton.querySelector(".btn-texto").textContent = "Enviar confirmación";
      mostrarAviso("No se pudo enviar. Revisa tu conexión e intenta de nuevo.");
      return;
    }

    form.style.transition = "opacity .5s ease, transform .5s ease";
    form.style.opacity = "0";
    form.style.transform = "translateY(-20px)";

    setTimeout(() => {
      form.style.display = "none";
      mostrarPase(registro);
      pintarMuro();
      mostrarAviso(DATOS.rsvp.mensajeGracias);
    }, 500);
  });
}

/* ------------------------------------------------------------
   Pase de entrada
   ------------------------------------------------------------ */
function mostrarPase(registro, alCargar = false) {
  const pase = $("#pase");

  $("#paseCodigo").textContent = registro.codigo;
  $("#paseNombre").textContent = registro.nombre;

  if (registro.asiste === "no") {
    pase.classList.add("declinado");
    $("#paseTitulo").textContent = "Te vamos a extrañar";
    $("#paseQr").style.display = "none";
    $("#paseCodigo").style.display = "none";
    $("#paseLugar").textContent = "Gracias por avisarnos. Emma te manda un abrazo.";
  } else {
    // el QR lleva a la pagina de verificacion: seguridad lo escanea y
    // ve al instante si el pase es real y quienes vienen con el
    dibujarQR($("#paseQr"), new URL(`verificar.html?c=${registro.codigo}`, location.href).href);
  }

  const texto = registro.asiste === "si"
    ? `Hola, soy ${registro.nombre}. Confirmo mi asistencia a los XV de ${DATOS.nombre}. Mi pase es ${registro.codigo}.`
    : `Hola, soy ${registro.nombre}. Lamento no poder acompañarlos en los XV de ${DATOS.nombre}.`;

  $("#btnWhatsapp").href = `https://wa.me/${DATOS.rsvp.whatsapp}?text=${encodeURIComponent(texto)}`;

  pase.classList.add("visible");
  if (alCargar) return;                       // al recargar: sin fanfarria
  if (registro.asiste === "si") lanzarDestellos(pase, 8, 300);
  pase.scrollIntoView({ behavior: SIN_MOVIMIENTO ? "auto" : "smooth", block: "center" });
}

function dibujarQR(contenedor, texto) {
  // La librería del QR se carga desde internet. Sin ella, el código
  // escrito debajo sigue sirviendo en la entrada.
  if (typeof qrcode === "undefined") {
    contenedor.innerHTML = `<p style="color:var(--pizarra);font-size:.78rem;padding:.6rem;max-width:150px">
      Sin conexión: presenta el código de abajo.</p>`;
    return;
  }
  const qr = qrcode(0, "H");           // corrección alta: admite el logo al centro
  qr.addData(texto);
  qr.make();
  contenedor.innerHTML = qr.createImgTag(5, 0) +
    `<img src="assets/marca/monograma-ev.png" alt="" class="pase-qr-logo">`;
}

/* ------------------------------------------------------------
   Muro de mensajes
   ------------------------------------------------------------ */
async function pintarMuro() {
  const muro = $("#muro");
  let mensajes;
  try { mensajes = await Almacen.mensajesPublicos(); }
  catch (e) { mensajes = []; }               // sin red: el muro queda en su invitacion

  muro.innerHTML = "";

  if (mensajes.length === 0) {
    muro.innerHTML = `
      <div class="muro-vacio">
        <svg><use href="#ico-sobre-abierto"/></svg>
        <p>Sé el primero en dejar un mensaje</p>
      </div>`;
    return;
  }

  // se muestran de a LOTE; el boton "Ver mas" revela el resto por tandas
  const LOTE = 6;
  let mostrados = 0;

  const pintarLote = () => {
    mensajes.slice(mostrados, mostrados + LOTE).forEach(m => {
      const nota = document.createElement("article");
      nota.className = "nota";
      nota.innerHTML = `
        <p class="nota-texto">“${escapar(m.mensaje)}”</p>
        <p class="nota-firma">— ${escapar(m.nombre)}</p>`;
      muro.appendChild(nota);
    });
    mostrados = Math.min(mostrados + LOTE, mensajes.length);

    const caja = $("#muroMas");
    const boton = $("#btnMasMensajes");
    const faltan = mensajes.length - mostrados;
    if (faltan > 0) {
      boton.textContent = `Ver más mensajes (${faltan})`;
      caja.hidden = false;
    } else {
      caja.hidden = true;
    }
  };

  $("#btnMasMensajes").onclick = pintarLote;
  pintarLote();
}

function escapar(texto) {
  const d = document.createElement("div");
  d.textContent = texto;
  return d.innerHTML;
}

/* ------------------------------------------------------------
   Música

   Arranca cuando el velo llega al blanco pleno, ya con la portada
   detras. No es "autoplay": nace del toque del invitado, que es justo
   lo que los navegadores exigen para dejar sonar el audio.
   ------------------------------------------------------------ */
const Musica = {
  boton: null, audio: null, yt: null,
  ytListo: false, sonando: false, pendiente: false,

  preparar() {
    const M = DATOS.musica;
    if (!M.archivo && !M.youtube) return;

    this.boton = $("#btnMusica");
    this.boton.classList.add("visible");
    this.boton.addEventListener("click", () => this.alternar());

    if (M.archivo) {
      this.audio = $("#audio");
      this.audio.src = M.archivo;
      this.audio.volume = M.volumen ?? .55;
    } else {
      this.cargarYouTube(M.youtube);
    }
  },

  cargarYouTube(id) {
    window.onYouTubeIframeAPIReady = () => {
      this.yt = new YT.Player("ytMusica", {
        videoId: id,
        playerVars: { controls: 0, disablekb: 1, playsinline: 1, loop: 1, playlist: id, rel: 0 },
        events: {
          onReady: () => {
            this.ytListo = true;
            this.yt.setVolume(Math.round((DATOS.musica.volumen ?? .55) * 100));
            if (this.pendiente) this.sonar();
          },
          onStateChange: e => {
            if (e.data === YT.PlayerState.PLAYING) this.marcar(true);
            if (e.data === YT.PlayerState.PAUSED)  this.marcar(false);
          }
        }
      });
    };
    const script = document.createElement("script");
    script.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(script);
  },

  /* iPhone solo deja arrancar audio dentro del gesto del invitado.
     Aqui, en pleno toque, la cancion arranca en silencio; sonar() le
     quita el silencio cuando el velo llega al blanco. En el resto de
     navegadores es inofensivo. */
  desbloquear() {
    if (DATOS.musica.silenciada || !this.audio || this.sonando) return;
    this.audio.muted = true;
    const intento = this.audio.play();
    if (intento) intento.catch(() => { this.audio.muted = false; });
  },

  sonar() {
    if (DATOS.musica.silenciada) return;   // en mute: solo suena si el invitado toca el botón
    if (this.audio) {
      if (!this.audio.paused) {
        // venia sonando en silencio desde el toque: al principio y a sonar
        this.audio.currentTime = 0;
        this.audio.muted = false;
        this.marcar(true);
        return;
      }
      this.audio.muted = false;
      this.audio.play().then(() => this.marcar(true)).catch(() => {});
      return;
    }
    if (this.yt && this.ytListo) { this.yt.playVideo(); this.marcar(true); }
    else this.pendiente = true;
  },

  alternar() {
    if (this.sonando) {
      if (this.audio) this.audio.pause();
      else if (this.yt) this.yt.pauseVideo();
      this.marcar(false);
      return;
    }
    if (this.audio) {
      this.audio.muted = false;
      this.audio.play()
        .then(() => this.marcar(true))
        .catch(() => mostrarAviso("No se encontró el archivo de música"));
    } else if (this.yt && this.ytListo) {
      this.yt.playVideo();
      this.marcar(true);
    } else {
      mostrarAviso("La música está cargando...");
    }
  },

  marcar(activa) {
    this.sonando = activa;
    this.boton.classList.toggle("sonando", activa);
    this.boton.setAttribute("aria-label", activa ? "Silenciar música" : "Reproducir música");
  }
};

function prepararMusica() { Musica.preparar(); }

/* ------------------------------------------------------------
   Aparición al hacer scroll
   ------------------------------------------------------------ */
function prepararAparicion() {
  const observador = new IntersectionObserver(entradas => {
    entradas.forEach(entrada => {
      if (!entrada.isIntersecting) return;
      entrada.target.classList.add("visible");
      entrada.target.querySelectorAll(".escalona").forEach(e => e.classList.add("visible"));
      observador.unobserve(entrada.target);
    });
  }, { threshold: 0, rootMargin: "0px 0px -10% 0px" });

  $$(".aparece").forEach(el => observador.observe(el));

  const obsEscalona = new IntersectionObserver(entradas => {
    entradas.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add("visible"); obsEscalona.unobserve(e.target); }
    });
  }, { threshold: 0, rootMargin: "0px 0px -10% 0px" });

  $$(".escalona").forEach(el => obsEscalona.observe(el));
}

/* ------------------------------------------------------------
   Barra de progreso y botón de volver arriba
   ------------------------------------------------------------ */
function prepararScroll() {
  const barra  = $("#progreso");
  const arriba = $("#btnArriba");
  let pendiente = false;

  const actualizar = () => {
    const alto = document.documentElement.scrollHeight - window.innerHeight;
    const y = window.scrollY;
    barra.style.width = alto > 0 ? `${(y / alto) * 100}%` : "0";
    const cercaDelFinal = alto - y < 260;
    arriba.classList.toggle("visible", y > 500 && !cercaDelFinal);
    pendiente = false;
  };

  window.addEventListener("scroll", () => {
    if (pendiente) return;
    pendiente = true;
    requestAnimationFrame(actualizar);
  }, { passive: true });

  arriba.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: SIN_MOVIMIENTO ? "auto" : "smooth" });
  });

  actualizar();
}

/* ------------------------------------------------------------
   Parallax: las flores se mueven menos que la página,
   las esferas un poco más. Solo en escritorio.
   ------------------------------------------------------------ */
function prepararParallax() {
  if (SIN_MOVIMIENTO || window.innerWidth < 768) return;

  const capas = $$(".veranera").map(el => ({ el, factor: .3 }));
  if (!capas.length) return;

  let pendiente = false;
  const alto = () => window.innerHeight;

  const mover = () => {
    capas.forEach(({ el, factor }) => {
      const caja = el.parentElement.getBoundingClientRect();
      if (caja.bottom < -200 || caja.top > alto() + 200) return;
      const centro = caja.top + caja.height / 2 - alto() / 2;
      el.style.translate = `0 ${(-centro * factor * .12).toFixed(1)}px`;
    });
    pendiente = false;
  };

  window.addEventListener("scroll", () => {
    if (pendiente) return;
    pendiente = true;
    requestAnimationFrame(mover);
  }, { passive: true });

  mover();
}

/* ------------------------------------------------------------
   Destellos: estrellitas al entrar y al aparecer el pase
   ------------------------------------------------------------ */
function lanzarDestellos(contenedor, cuantos, retraso) {
  if (SIN_MOVIMIENTO || !contenedor) return;

  const caja = contenedor.getBoundingClientRect();
  if (!caja.width) return;

  if (getComputedStyle(contenedor).position === "static") {
    contenedor.style.position = "relative";
  }

  for (let i = 0; i < cuantos; i++) {
    setTimeout(() => {
      const estrella = document.createElement("span");
      estrella.className = "destello";
      const tam = 10 + Math.random() * 14;
      estrella.style.width = estrella.style.height = `${tam}px`;
      estrella.style.left = `${(Math.random() * caja.width).toFixed(0)}px`;
      estrella.style.top  = `${(Math.random() * caja.height).toFixed(0)}px`;
      contenedor.appendChild(estrella);
      setTimeout(() => estrella.remove(), 1600);
    }, retraso + i * 110);
  }
}

/* ------------------------------------------------------------
   Aviso flotante
   ------------------------------------------------------------ */
let temporizadorAviso;
function mostrarAviso(texto) {
  const aviso = $("#aviso");
  aviso.textContent = texto;
  aviso.classList.add("visible");
  clearTimeout(temporizadorAviso);
  temporizadorAviso = setTimeout(() => aviso.classList.remove("visible"), 2800);
}
