/* ============================================================
   ALMACÉN DE CONFIRMACIONES

   Antes esto era localStorage: cada confirmación se quedaba en el
   teléfono de quien la escribía y nunca llegaba al panel. Ahora
   guarda en Supabase; lo que cada quien puede hacer lo deciden las
   reglas del servidor (supabase/esquema.sql):

   - cualquiera puede INSERTAR su confirmación;
   - el muro público solo LEE mensajes ya aprobados desde el panel,
     y únicamente nombre, mensaje y fecha;
   - todo lo demás exige el login del panel (admin.html).

   En el teléfono solo queda una copia de la confirmación PROPIA,
   para volver a mostrar el pase si el invitado reabre la página.
   ============================================================ */

const Almacen = {

  LLAVE_MIA: "rsvp_emma_mia",

  _pedir(ruta, opciones = {}) {
    const S = DATOS.supabase;
    return fetch(`${S.url}/rest/v1/${ruta}`, {
      ...opciones,
      headers: {
        apikey: S.clave,
        Authorization: `Bearer ${S.clave}`,
        "Content-Type": "application/json",
        ...(opciones.headers || {})
      }
    });
  },

  /* Guarda una confirmación nueva y devuelve el registro creado.
     Lanza un error si la red o el servidor fallan: el formulario
     avisa y el invitado puede intentar de nuevo. */
  async guardar(datos) {
    const registro = {
      familia: datos.familia || null,
      nombre: datos.nombre.trim(),
      acompanantes: (datos.acompanantes || []).map(n => n.trim()).filter(Boolean),
      puestos: datos.puestos || null,
      asiste: datos.asiste,                    // "si" | "no"
      cancion: (datos.cancion || "").trim() || null,
      mensaje: (datos.mensaje || "").trim() || null,
      codigo: this._nuevoCodigo(datos.nombre)
    };

    const r = await this._pedir("confirmaciones", {
      method: "POST",
      headers: { Prefer: "return=minimal" },
      body: JSON.stringify(registro)
    });
    if (!r.ok) throw new Error("Supabase respondió " + r.status);

    registro.fecha = new Date().toISOString();
    try { localStorage.setItem(this.LLAVE_MIA, JSON.stringify(registro)); }
    catch (e) { /* sin localStorage (modo privado): el pase solo dura la sesión */ }
    return registro;
  },

  /* La confirmación hecha desde ESTE navegador, si existe. */
  mia() {
    try { return JSON.parse(localStorage.getItem(this.LLAVE_MIA)); }
    catch (e) { return null; }
  },

  /* Mensajes del muro público: solo los ya aprobados en el panel. */
  async mensajesPublicos() {
    const r = await this._pedir(
      "confirmaciones?select=nombre,mensaje,creado&order=creado.desc&limit=80");
    if (!r.ok) throw new Error("Supabase respondió " + r.status);
    return r.json();
  },

  /* Código de pase corto y legible, ej: EMMA-K7P2 */
  _nuevoCodigo(nombre) {
    const inicial = (nombre.trim()[0] || "X").toUpperCase();
    const prefijo = DATOS.nombre.replace(/[^a-z0-9]/gi, "").slice(0, 8).toUpperCase() || "XV";
    const letras = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";  // sin caracteres confusos
    let sufijo = "";
    for (let i = 0; i < 4; i++) {
      sufijo += letras[Math.floor(Math.random() * letras.length)];
    }
    return `${prefijo}-${inicial}${sufijo}`;
  }
};
